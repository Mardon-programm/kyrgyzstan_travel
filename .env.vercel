# =============================================================================
# VERCEL DEPLOYMENT ENVIRONMENT VARIABLES
# Copy these to Vercel Dashboard → Settings → Environment Variables
# =============================================================================

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-django-key-here-generate-new-one

# Must be False in production
DEBUG=False

# Django settings module for Vercel deployment
DJANGO_SETTINGS_MODULE=config.settings_vercel

# Vercel automatically sets this, but can be overridden
# VERCEL_URL=your-project.vercel.app

# =============================================================================
# DATABASE (Required)
# =============================================================================
# Use Vercel Postgres, Neon, Supabase, or Railway PostgreSQL
# Format: postgresql://user:password@host:5432/database?sslmode=require

# Option 1: Vercel Postgres (recommended - auto-configured)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option 2: Neon (serverless Postgres)
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Option 3: Supabase
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?sslmode=require

# Option 4: Railway
# DATABASE_URL=postgresql://user:password@host.railway.app:5432/dbname?sslmode=require

# Option 5: Individual settings (alternative to DATABASE_URL)
# POSTGRES_DB=kyrgyzstan_travel
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-secure-password
# POSTGRES_HOST=your-db-host
# POSTGRES_PORT=5432

# =============================================================================
# CORS & CSRF SETTINGS
# =============================================================================
# Vercel automatically sets VERCEL_URL, but you can override
# VERCEL_URL=your-project.vercel.app

# Frontend URL (your Vercel deployment URL)
# CORS_ALLOWED_ORIGINS=https://your-project.vercel.app,https://your-custom-domain.com

# CSRF trusted origins (must match your frontend domain)
# CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app,https://your-custom-domain.com

# Custom domains (comma-separated)
# CUSTOM_DOMAINS=yourdomain.com,www.yourdomain.com

# =============================================================================
# OPTIONAL: EMAIL SETTINGS
# =============================================================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# =============================================================================
# OPTIONAL: REDIS (for caching/celery)
# =============================================================================
# REDIS_URL=redis://user:pass@host:6379/0

# =============================================================================
# OPTIONAL: STORAGE (for media files)
# =============================================================================
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=your-bucket.s3.amazonaws.com

# =============================================================================
# OPTIONAL: CELERY (background tasks)
# =============================================================================
# CELERY_BROKER_URL=redis://user:pass@host:6379/0
# CELERY_RESULT_BACKEND=redis://user:pass@host:6379/0

# =============================================================================
# VERCEL AUTO-SET VARIABLES (DO NOT SET MANUALLY)
# =============================================================================
# VERCEL_URL=your-project.vercel.app (auto-set by Vercel)
# VERCEL_GIT_COMMIT_SHA=abc123 (auto-set)
# VERCEL_GIT_COMMIT_MESSAGE=... (auto-set)
# VERCEL_GIT_COMMIT_AUTHOR_LOGIN=... (auto-set)