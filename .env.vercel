# Vercel Environment Variables
# Copy this to your Vercel project settings

# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings_vercel

# Database (use Vercel Postgres, Neon, or Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Or individual DB settings
# POSTGRES_DB=kyrgyzstan_travel
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-password
# POSTGRES_HOST=your-db-host
# POSTGRES_PORT=5432

# CORS & CSRF (add your Vercel domain)
# VERCEL_URL=your-project.vercel.app
# CORS_ALLOWED_ORIGINS=https://your-project.vercel.app,https://your-custom-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app,https://your-custom-domain.com
# CUSTOM_DOMAINS=your-custom-domain.com

# Optional: Email
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Optional: Redis (for caching/celery)
# REDIS_URL=redis://localhost:6379/0