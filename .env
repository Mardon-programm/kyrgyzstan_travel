# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# Copy this to .env in the backend directory
# =============================================================================

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-key-change-in-production

# Enable debug mode for development
DEBUG=True

# Django settings module for local development
DJANGO_SETTINGS_MODULE=config.settings

# =============================================================================
# DATABASE (Local PostgreSQL via Docker)
# =============================================================================
# Default docker-compose PostgreSQL settings
POSTGRES_DB=kyrgyzstan_travel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Or use DATABASE_URL (alternative)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/kyrgyzstan_travel

# =============================================================================
# CORS & CSRF SETTINGS (Local Development)
# =============================================================================
# Frontend development server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# OPTIONAL: EMAIL SETTINGS (Console backend for development)
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# =============================================================================
# OPTIONAL: REDIS (for caching/celery)
# =============================================================================
# REDIS_URL=redis://redis:6379/0

# =============================================================================
# OPTIONAL: CELERY (background tasks)
# =============================================================================
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# OPTIONAL: CELERY BEAT SCHEDULE
# =============================================================================
# CELERY_BEAT_SCHEDULER=django_celery_beat.schedulers:DatabaseScheduler