{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "api",
      "framework": "django"
    },
    "backend": {
      "root": "backend",
      "framework": "django"
    },
    "kyrgyzstan-travel": {
      "root": "kyrgyzstan-travel",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "kyrgyzstan-travel"
      }
    }
  ]
}