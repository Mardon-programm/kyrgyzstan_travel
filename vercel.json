{
  "version": 2,
  "buildCommand": "cd kyrgyzstan-travel && npm run build",
  "outputDirectory": "kyrgyzstan-travel/dist",
  "framework": "vite",
  "functions": {
    "api/index.py": {
      "runtime": "python@3.11",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/admin/$1"
    },
    {
      "source": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings_vercel",
    "DEBUG": "False"
  }
}