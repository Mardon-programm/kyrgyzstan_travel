{
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd kyrgyzstan-travel && npm run build",
  "outputDirectory": "kyrgyzstan-travel/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/admin/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings_vercel",
    "DEBUG": "False"
  }
}