{
  "version": 2,
  "builds": [
    {
      "src": "kyrgyzstan-travel/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "kyrgyzstan-travel/dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings_vercel",
    "DEBUG": "False"
  }
}