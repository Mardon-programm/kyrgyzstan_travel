{
  "version": 2,
  "buildCommand": "cd kyrgyzstan-travel && npm install && npm run build",
  "outputDirectory": "kyrgyzstan-travel/dist",
  "functions": {
    "backend/config/wsgi.py": {
      "runtime": "@vercel/python"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/config/wsgi.py" },
    { "source": "/admin/(.*)", "destination": "/backend/config/wsgi.py" },
    { "source": "/admin", "destination": "/backend/config/wsgi.py" },
    { "source": "/((?!api|admin|assets).*)", "destination": "/kyrgyzstan-travel/dist/$1" },
    { "source": "/(.*)", "destination": "/kyrgyzstan-travel/dist/index.html" }
  ]
}