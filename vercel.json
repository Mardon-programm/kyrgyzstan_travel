{
  "version": 2,
  "builds": [
    {
      "src": "kyrgyzstan-travel/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/config/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/config/wsgi.py" },
    { "src": "/admin/(.*)", "dest": "backend/config/wsgi.py" },
    { "src": "/admin", "dest": "backend/config/wsgi.py" },
    { "src": "^/assets/(.*)$", "dest": "/kyrgyzstan-travel/dist/assets/$1" },
    { "src": "^/(.*\\.(js|css|ico|png|jpg|svg|json|woff2?))$", "dest": "/kyrgyzstan-travel/dist/$1" },
    { "src": "/(.*)", "dest": "/kyrgyzstan-travel/dist/index.html" }
  ]
}